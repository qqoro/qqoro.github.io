---
interface Props {
  title: string;
  lede: string;
  items: string[];
  warm?: boolean;
}
const { title, lede, items, warm = false } = Astro.props;
---

<section class:list={['chips', 'wrap', { 'chips--warm': warm }]}>
  <div class="head">
    <h2>{title}</h2>
    <p>{lede}</p>
  </div>
  <ul>
    {items.map((it) => <li>{it}</li>)}
  </ul>
</section>

<style>
  .chips {
    padding: var(--space-2xl) 0 var(--space-3xl);
    border-top: 1px solid var(--rule);
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-xl);
  }
  .head h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-display-s);
    line-height: 1;
  }
  .head p {
    margin: 0;
    color: var(--color-ink-2);
  }
  /* 상자 대신 선으로만 나눈다 */
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    column-gap: var(--space-xl);
  }
  li {
    padding: var(--space-md) 0;
    border-top: 1px solid var(--rule);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    display: flex;
    gap: var(--space-sm);
    align-items: baseline;
  }
  li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--color-glow);
    transform: translateY(-1px);
  }
  .chips--warm li::before {
    background: var(--color-accent-2);
    box-shadow: 0 0 8px var(--color-glow-2);
  }
</style>
