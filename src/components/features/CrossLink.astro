---
interface Props {
  lead: string;
  name: string;
  href: string;
  warm?: boolean;
}
const { lead, name, href, warm = false } = Astro.props;
---

<section class="cross wrap">
  <a class:list={['card', { 'card--warm': warm }]} href={href}>
    <span class="lead">{lead}</span>
    <span class="name">
      {name}
      <svg width="0.8em" height="0.8em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
    </span>
  </a>
</section>

<style>
  .cross {
    padding: 0 0 var(--space-3xl);
  }
  .card {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    background: var(--color-paper-2);
    border: 1px solid var(--rule);
    text-decoration: none;
    transition: box-shadow var(--dur-base) var(--ease-out);
  }
  .card:hover {
    box-shadow: 0 40px 90px -36px var(--color-glow);
  }
  .card--warm:hover {
    box-shadow: 0 40px 90px -36px var(--color-glow-2);
  }
  .lead {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    letter-spacing: 0.08em;
  }
  .name {
    display: inline-flex;
    align-items: center;
    gap: var(--space-md);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-2xl);
    line-height: 1.1;
    color: var(--color-accent);
    text-shadow: 0 0 18px var(--color-glow);
  }
  .card--warm .name {
    color: var(--color-accent-2);
    text-shadow: 0 0 18px var(--color-glow-2);
  }
  .name svg {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .card:hover .name svg {
    transform: translateX(6px);
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .name svg {
      transition: none;
    }
  }
</style>
