---
// 스크린샷 크게 보기. [data-zoom] 링크를 누르면 원본을 화면에 맞춰 띄우고,
// 화면보다 큰 원본은 한 번 더 누르면 실제 크기로 펼쳐 스크롤로 훑는다
---

<dialog class="lightbox" aria-label="스크린샷 크게 보기">
  <img alt="" />
  <button class="close" type="button" aria-label="닫기">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
  </button>
</dialog>

<script>
  // 번들 스크립트는 한 번만 돈다. 대화상자는 페이지마다 새로 깔리므로 누를 때마다 다시 찾는다
  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    const link = target.closest<HTMLAnchorElement>('a[data-zoom]');
    const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
    if (!dialog) return;

    if (link) {
      e.preventDefault();
      const img = dialog.querySelector('img')!;
      dialog.classList.remove('actual', 'can-actual');
      img.src = link.href;
      img.alt = link.querySelector('img')?.alt ?? '';
      dialog.showModal();
      // 같은 그림을 다시 열면 load가 안 오므로 이미 받아 둔 경우 직접 잰다
      if (img.complete) requestAnimationFrame(() => measure(img));
      return;
    }
    if (!dialog.open || !dialog.contains(target)) return;

    // 원본이 화면보다 커서 줄여 보이는 중일 때만 실제 크기로 넘긴다
    if (target instanceof HTMLImageElement && (dialog.classList.contains('can-actual') || dialog.classList.contains('actual'))) {
      const actual = dialog.classList.toggle('actual');
      if (actual) {
        // 누른 지점이 화면 가운데 오도록 펼친다
        const r = target.getBoundingClientRect();
        const fx = (e as MouseEvent).clientX - r.left;
        const fy = (e as MouseEvent).clientY - r.top;
        const scale = target.naturalWidth / r.width;
        requestAnimationFrame(() => {
          dialog.scrollTo(fx * scale - dialog.clientWidth / 2, fy * scale - dialog.clientHeight / 2);
        });
      }
      return;
    }
    // 이미지 바깥(배경)이나 닫기 버튼
    dialog.close();
  });

  // 이미지가 실제로 줄어 들어갔는지는 그려진 뒤에야 안다
  function measure(img: HTMLImageElement) {
    img.closest('dialog')?.classList.toggle('can-actual', img.naturalWidth > img.clientWidth + 1);
  }
  document.addEventListener(
    'load',
    (e) => {
      const img = e.target as Element;
      if (img instanceof HTMLImageElement && img.closest('dialog.lightbox')) measure(img);
    },
    true,
  );
</script>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    overflow: hidden;
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox::backdrop {
    background: oklch(8% 0.01 260 / 0.88);
    backdrop-filter: blur(6px);
  }
  .lightbox img {
    max-width: calc(100vw - 2 * var(--space-lg));
    max-height: calc(100dvh - 2 * var(--space-lg));
    width: auto;
    height: auto;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-card);
  }
  .lightbox.can-actual img {
    cursor: zoom-in;
  }
  .lightbox.actual {
    overflow: auto;
    place-items: start;
  }
  .lightbox.actual img {
    max-width: none;
    max-height: none;
    border-radius: 0;
    cursor: zoom-out;
  }
  .close {
    position: fixed;
    top: var(--space-md);
    right: var(--space-md);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    background: var(--color-paper-2);
    color: inherit;
    cursor: pointer;
  }
  .close:hover {
    background: var(--color-paper-3);
  }
  /* 열려 있는 동안 뒤 페이지가 같이 굴러가지 않게 */
  :global(html:has(dialog.lightbox[open])) {
    overflow: hidden;
  }
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open],
    .lightbox[open]::backdrop {
      animation: lightbox-in var(--dur-base) var(--ease-out);
    }
  }
  @keyframes lightbox-in {
    from {
      opacity: 0;
    }
  }
</style>
